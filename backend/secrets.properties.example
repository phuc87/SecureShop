# =====================================================================
# Copy file này thành  secrets.properties  (cùng thư mục backend) rồi điền thông tin thật.
# File secrets.properties đã nằm trong .gitignore -> không bị đưa lên GitHub.
# Sửa xong phải KHỞI ĐỘNG LẠI backend (đóng cửa sổ backend, nhấp đúp start-backend.bat).
# =====================================================================

# Gmail dùng để GỬI email đơn hàng
MAIL_USERNAME=tencuahang@gmail.com

# App Password 16 ký tự, KHÔNG phải mật khẩu Gmail. Dán nguyên dạng "abcd efgh ijkl mnop" cũng được (hệ thống tự bỏ dấu cách).
# Cách tạo: bật Xác minh 2 bước cho Gmail -> https://myaccount.google.com/apppasswords -> tạo mật khẩu ứng dụng.
MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# (Không bắt buộc) Email nhận thông báo "có đơn hàng mới". Bỏ trống = gửi về chính MAIL_USERNAME.
ADMIN_NOTIFY_EMAIL=

# ===== Đăng nhập bằng Google (không bắt buộc) =====
# Client ID dạng 123456789-abc...apps.googleusercontent.com (xem hướng dẫn trong docs/dang-nhap-google.md)
GOOGLE_CLIENT_ID=
